PORT=8080
NODE_ENV=development
# Set this to a long random value in production. The Flutter app sends it as X-AYAT-APP-TOKEN.
AYAT_APP_TOKEN=replace-with-a-long-random-token
# Optional. Keep the key ONLY on this server. OpenAI billing may apply.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional provider adapter URL for a licensed/authorized hadith search service.
HADITH_PROVIDER_URL=
HADITH_PROVIDER_TOKEN=
CORS_ORIGINS=*
